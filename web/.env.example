# Copy to .env.local for local development. Deployed builds get these as build
# variables on the stack-the-lineup-web Worker (Cloudflare → Settings → Builds).
# Use the PUBLISHABLE key (sb_publishable_...). Never put a secret/service_role key here:
# every EXPO_PUBLIC_ value is shipped to the browser.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# RevenueCat's public Web Billing key (Project settings → API keys → the Web
# Billing app). rcb_sb_... is the sandbox key (test cards only); rcb_... is
# production. Leave unset and the paywall says Pro is sold on iPhone instead.
EXPO_PUBLIC_REVENUECAT_WEB_KEY=rcb_sb_...
