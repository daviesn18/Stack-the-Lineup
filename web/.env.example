# Copy to .env.local for local development. On Vercel, set these per environment:
# Preview -> staging project, Production -> production project.
# Use the PUBLISHABLE key (sb_publishable_...). Never put a secret/service_role key here:
# every EXPO_PUBLIC_ value is shipped to the browser.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
