			<string>com.stackthelineup.stlteam</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>stlteam</string>
				</array>
			</dict>
		</dict>
	</array>
